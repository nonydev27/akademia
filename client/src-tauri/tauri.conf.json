{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Akademia",
  "version": "0.1.0",
  "identifier": "com.akademia.schoolmgmt",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Akademia — School Management System",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/OWNER/REPO/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_UPDATER_PUBLIC_KEY",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "wix": {},
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": true
      }
    },
    "resources": [],
    "externalBin": [],
    "copyright": "",
    "category": "Education",
    "shortDescription": "Multi-tenant school management platform",
    "longDescription": "Akademia is a multi-tenant school management system for Primary, JHS, and SHS schools. It covers attendance, fees, grading, automated result-fee intercept, communications, and per-school subscription licensing.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}