// Prisma schema — Akademia core data model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  STAFF
}

enum SchoolLevel {
  PRIMARY
  JHS
  SHS
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED_IN_GRACE
  EXPIRED_LOCKED
}

enum SubscriptionPlan {
  BASIC
  STANDARD
  PREMIUM
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum ReportCardStatus {
  DRAFT
  SUBMITTED
  APPROVED
  WITHHELD
  RELEASED
}

enum CommunicationChannel {
  EMAIL
  SMS
}

enum CommunicationStatus {
  SENT
  FAILED
}

// --- Tenancy ---

model Tenant {
  id           String      @id @default(uuid())
  name         String
  code         String      @unique // school initials, e.g. VIS for Vilaworld International School
  studentSeq   Int         @default(0) // last used student number -> builds VIS-001, VIS-002…
  schoolLevel  SchoolLevel
  adminPhone   String?
  adminContact String?
  createdAt    DateTime    @default(now())

  users          User[]
  students       Student[]
  subscription   Subscription?
  academicYears  AcademicYear[]
  classes        Class[]
  subjects       Subject[]
  guardians      Guardian[]
  feeStructures  FeeStructure[]
  auditLogs      AuditLog[]
  communications Communication[]
  gradeBands     GradeBand[]
}

model Subscription {
  id              String             @id @default(uuid())
  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  tenantId        String             @unique
  status          SubscriptionStatus @default(ACTIVE)
  plan            SubscriptionPlan   @default(BASIC)
  expiresAt       DateTime
  graceEndsAt     DateTime?
  lastPaymentRef  String?
  lastPaymentAt   DateTime?
  lastPaymentAmt  Float?
  features        Json               @default("{}")
  updatedAt       DateTime           @updatedAt
}

// --- Users / Auth ---

model User {
  id         String   @id @default(uuid())
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  tenantId   String?
  role       Role
  fullName   String
  email      String   @unique
  phone      String?
  image      String?
  supabaseId String   @unique
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  teacherAssignments TeacherClassSubject[]

  @@index([tenantId])
}

enum TermStatus {
  ACTIVE
  INACTIVE
  UPCOMING
}

// --- Academic structure ---

model AcademicYear {
  id       String @id @default(uuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String
  label    String

  terms Term[]

  @@index([tenantId])
}

model Term {
  id             String       @id @default(uuid())
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  academicYearId String
  label          String
  status         TermStatus   @default(UPCOMING)
  startDate      DateTime
  endDate        DateTime

  grades        Grade[]
  reportCards   ReportCard[]
  feeStructures FeeStructure[]

  @@index([academicYearId])
}

model Class {
  id       String @id @default(uuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String
  name     String
  code     String // admin-facing Class ID, e.g. JHS2-A
  enrollments        Enrollment[]
  teacherAssignments TeacherClassSubject[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Enrollment {
  id        String  @id @default(uuid())
  student   Student @relation(fields: [studentId], references: [id])
  studentId String
  class     Class   @relation(fields: [classId], references: [id])
  classId   String

  @@index([classId])
  @@index([studentId])
}

// --- Students & guardians ---

model Student {
  id               String    @id @default(uuid())
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  tenantId         String
  // admissionNumber is the admin/teacher-facing Student ID, e.g. VIS-001.
  // Generated from the school code + a per-school sequence.
  admissionNumber  String
  fullName         String
  dateOfBirth      DateTime?
  gender           String?
  nationality      String?
  religion         String?
  address          String?
  email            String?
  phone            String?
  // Academic
  previousSchool   String?
  admissionDate    DateTime  @default(now())
  // Co-curricular
  sports           String?
  clubs            String?
  otherActivities  String?
  // Identification
  nhisNumber       String?
  profilePicUrl    String?
  active           Boolean   @default(true)

  guardians   StudentGuardian[]
  enrollments Enrollment[]
  attendance  Attendance[]
  grades      Grade[]
  feeAccount  StudentFeeAccount?
  reportCards ReportCard[]

  @@unique([tenantId, admissionNumber])
  @@index([tenantId])
}

model Guardian {
  id       String @id @default(uuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String
  fullName String
  phone    String
  email    String?

  students StudentGuardian[]

  @@index([tenantId])
}

model StudentGuardian {
  id         String   @id @default(uuid())
  student    Student  @relation(fields: [studentId], references: [id])
  studentId  String
  guardian   Guardian @relation(fields: [guardianId], references: [id])
  guardianId String
  relation   String?

  @@index([studentId])
  @@index([guardianId])
}

// --- Attendance ---

model Attendance {
  id             String          @id @default(uuid())
  student        Student         @relation(fields: [studentId], references: [id])
  studentId      String
  subject        Subject?        @relation(fields: [subjectId], references: [id])
  subjectId      String?
  date           DateTime
  status         AttendanceStatus
  markedByUserId String?

  @@unique([studentId, subjectId, date])
}

// --- Subjects & grading ---

model GradeBand {
  id       String @id @default(uuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String
  letter   String // "A", "B", "C", etc.
  minScore Float
  maxScore Float
  remark   String // "Excellent", "Very Good", etc.

  @@unique([tenantId, letter])
  @@index([tenantId])
}

model Subject {
  id       String @id @default(uuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String
  name     String
  code     String   // admin-facing Subject ID, e.g. ENGLP2
  pin      String?  // hashed 4-digit pin set by teacher
  pinOwnerId String? // the teacher (User) who set/owns the PIN

  grades               Grade[]
  teacherAssignments   TeacherClassSubject[]
  attendance           Attendance[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

/// Assigns a teacher (STAFF user) to a specific class + subject.
/// accessCode is the teacher-facing surrogate key that identifies this
/// assignment without ever exposing a UUID.
model TeacherClassSubject {
  id         String   @id @default(uuid())
  teacher    User     @relation(fields: [teacherId], references: [id])
  teacherId  String
  class      Class    @relation(fields: [classId], references: [id])
  classId    String
  subject    Subject  @relation(fields: [subjectId], references: [id])
  subjectId  String
  accessCode String?  // e.g. T-AO-ENGLP2-JHS2A (shown to teacher, not a UUID)
  createdAt  DateTime @default(now())

  @@unique([teacherId, classId, subjectId])
  @@index([teacherId])
  @@index([classId])
  @@index([subjectId])
}

model Grade {
  id            String    @id @default(uuid())
  student       Student   @relation(fields: [studentId], references: [id])
  studentId     String
  subject       Subject   @relation(fields: [subjectId], references: [id])
  subjectId     String
  term          Term      @relation(fields: [termId], references: [id])
  termId        String
  caScore       Float?
  midtermScore  Float?
  examScore     Float?
  aggregate     Float?
  remarks       String?
  finalized     Boolean   @default(false)
  finalizedAt   DateTime?
  enteredById   String?

  @@unique([studentId, subjectId, termId])
  @@index([studentId])
  @@index([subjectId])
  @@index([termId])
}

// --- Fees ---

model FeeStructure {
  id       String @id @default(uuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String
  term     Term   @relation(fields: [termId], references: [id])
  termId   String
  amount   Float
  label    String

  @@index([tenantId])
  @@index([termId])
}

model StudentFeeAccount {
  id           String  @id @default(uuid())
  student      Student @relation(fields: [studentId], references: [id])
  studentId    String  @unique
  totalCharged Float   @default(0)
  totalPaid    Float   @default(0)

  payments Payment[]
}

model Payment {
  id        String            @id @default(uuid())
  account   StudentFeeAccount @relation(fields: [accountId], references: [id])
  accountId String
  amount    Float
  reference String            @unique
  validated Boolean           @default(false)
  paidAt    DateTime          @default(now())

  @@index([accountId])
}

// --- Report cards ---

model ReportCard {
  id          String           @id @default(uuid())
  student     Student          @relation(fields: [studentId], references: [id])
  studentId   String
  term        Term             @relation(fields: [termId], references: [id])
  termId      String
  status      ReportCardStatus @default(DRAFT)
  submittedAt DateTime?
  approvedAt  DateTime?
  approvedBy  String?
  pdfUrl      String?
  publishedAt DateTime?

  @@unique([studentId, termId])
}

// --- Communications log ---

model Communication {
  id               String               @id @default(uuid())
  tenant           Tenant               @relation(fields: [tenantId], references: [id])
  tenantId         String
  channel          CommunicationChannel
  recipient        String
  templateKey      String
  status           CommunicationStatus
  providerResponse String?
  payload          Json?
  createdAt        DateTime             @default(now())

  @@index([tenantId])
}

// --- Audit ---

model AuditLog {
  id         String   @id @default(uuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  tenantId   String
  actorId    String
  action     String
  targetType String
  targetId   String
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId])
}
