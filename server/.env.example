# --- App ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Database (PostgreSQL, e.g. Supabase connection string) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/akademia?schema=public"

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=replace_with_another_long_random_string
REFRESH_TOKEN_EXPIRES_IN=30d

# --- Email (NodeMailer / Resend) ---
EMAIL_PROVIDER=resend            # resend | smtp
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Akademia <no-reply@akademia.app>"

# --- SMS (Arkesel / Hubtel) ---
SMS_PROVIDER=arkesel              # arkesel | hubtel
ARKESEL_API_KEY=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
SMS_SENDER_ID=Akademia

# --- Payments (subscription renewals) ---
PAYMENT_PROVIDER=paystack         # paystack | flutterwave
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# --- Subscription rules ---
SUBSCRIPTION_GRACE_PERIOD_DAYS=14

# --- Seed script (server/prisma/seed.js) ---
SEED_SUPER_ADMIN_EMAIL=superadmin@akademia.app
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
