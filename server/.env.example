# --- App ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Database (Supabase Postgres connection string — use the "Session" pooler
# connection string from Project Settings > Database) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# --- Supabase (Auth + Storage) ---
# Project Settings > API. SUPABASE_SERVICE_ROLE_KEY is server-only — never
# expose it to the client.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=replace_with_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPABASE_STORAGE_BUCKET=report-cards

# --- Email (NodeMailer / Resend) ---
EMAIL_PROVIDER=resend            # resend | smtp
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Akademia <no-reply@akademia.app>"

# --- SMS (Arkesel / Hubtel) ---
SMS_PROVIDER=arkesel              # arkesel | hubtel
ARKESEL_API_KEY=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
SMS_SENDER_ID=Akademia

# --- Payments (subscription renewals) ---
PAYMENT_PROVIDER=paystack         # paystack | flutterwave
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# --- Subscription rules ---
SUBSCRIPTION_GRACE_PERIOD_DAYS=14

# --- Seed script (server/prisma/seed.js) ---
SEED_SUPER_ADMIN_EMAIL=superadmin@akademia.app
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
