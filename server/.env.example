# --- App ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Database (Supabase Postgres via the Supavisor pooler — Project Settings
# > Database > Connection string. The direct db.<ref>.supabase.co host is
# IPv6-only, so use the pooler for both: transaction mode (6543) for the app,
# session mode (5432) for migrations.) ---
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Supabase (Auth + Storage) ---
# Project Settings > API. SUPABASE_SERVICE_ROLE_KEY is server-only — never
# expose it to the client.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=replace_with_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPABASE_STORAGE_BUCKET=report-cards

# --- Email (NodeMailer / Resend) ---
EMAIL_PROVIDER=resend            # resend | smtp
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Akademia <no-reply@akademia.app>"

# --- SMS (Arkesel / Hubtel) ---
SMS_PROVIDER=arkesel              # arkesel | hubtel
ARKESEL_API_KEY=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
SMS_SENDER_ID=Akademia

# --- Payments (subscription renewals) ---
PAYMENT_PROVIDER=paystack         # paystack | flutterwave
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# --- Subscription rules ---
SUBSCRIPTION_GRACE_PERIOD_DAYS=14

# --- Seed script (server/prisma/seed.js) ---
SEED_SUPER_ADMIN_EMAIL=superadmin@akademia.app
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
